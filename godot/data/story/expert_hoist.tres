[resource]
script = ExtResource("1_cutscene_timeline")
length = 990
tracks = Array[ExtResource("2_cutscene_track")]([SubResource("Track_1"), SubResource("Track_2"), SubResource("Track_3"), SubResource("Track_4"), SubResource("Track_5"), SubResource("Track_6"), SubResource("Track_7")])
provenance = "Original: ExpertClosingSequence 0x41c650 (CLOSING.C), the first stage: the sub turns (ExpertClosingTurnTable), idles 20 steps, the hook comes down 16 steps of 12 px and closes, then the cable pulls the sub and the artifact up 17 steps. One step is 18 ticks; the pictures of the sub (cell, propeller phase) and the artifact toggle every step. Constants are in tools/import/step_story.py with the function they were read from."
