[resource]
script = ExtResource("1_cutscene_timeline")
length = 640
loop = true
tracks = Array[ExtResource("2_cutscene_track")]([SubResource("Track_1"), SubResource("Track_2"), SubResource("Track_3"), SubResource("Track_4"), SubResource("Track_5"), SubResource("Track_6"), SubResource("Track_7")])
provenance = "Original: the alarm lights' four states and the pulsing ring, one step per 10 tick redraw (docs/data/opening.json). Ours: the loop length of 64 redraws."
