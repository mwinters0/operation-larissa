[resource]
script = ExtResource("1_cutscene_timeline")
length = 2628
tracks = Array[ExtResource("2_cutscene_track")]([SubResource("Track_1"), SubResource("Track_2"), SubResource("Track_3"), SubResource("Track_4"), SubResource("Track_5"), SubResource("Track_6"), SubResource("Track_7"), SubResource("Track_8"), SubResource("Track_9"), SubResource("Track_10"), SubResource("Track_11"), SubResource("Track_12"), SubResource("Track_13"), SubResource("Track_14"), SubResource("Track_15"), SubResource("Track_16"), SubResource("Track_17"), SubResource("Track_18"), SubResource("Track_19"), SubResource("Track_20"), SubResource("Track_21"), SubResource("Track_22"), SubResource("Track_23"), SubResource("Track_24"), SubResource("Track_25"), SubResource("Track_26"), SubResource("Track_27"), SubResource("Track_28"), SubResource("Track_29"), SubResource("Track_30"), SubResource("Track_31"), SubResource("Track_32")])
provenance = "Original: the deck shot of ExpertClosingSequence: the sub rises into the ship for 6 steps, then six sailors walk and wave for 140 steps (ExpertClosingCrewStep 0x41ceb7 run on docs/data/expert_closing.json) while the control box at the right edge blinks (ExpertClosingDrawPod 0x41cdba). Nothing of it is ours."
