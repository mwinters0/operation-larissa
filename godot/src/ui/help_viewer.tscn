[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/help_viewer.gd" id="1_help"]

[node name="HelpViewer" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_help")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_type_variation = &"ConsolePanel"

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsoleTitle"
text = "Help"

[node name="Body" type="RichTextLabel" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 250)
layout_mode = 2

[node name="PageNumber" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
horizontal_alignment = 1
text = "1 / 1"

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Rows"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Back" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Go Back a Page"

[node name="Next" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "See Next Page"

[node name="Done" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Done"
