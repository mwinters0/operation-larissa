[gd_resource type="Resource" script_class="StoryScene" format=3]

[ext_resource type="Script" path="res://src/resources/story_scene.gd" id="1_story_scene"]
[ext_resource type="Script" path="res://src/resources/speech_step.gd" id="2_speech_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_speech_step")
pause_ticks = 200
group = &"news_speech_0"

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_speech_step")
pause_ticks = 200
group = &"news_speech_1"

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_speech_step")
pause_ticks = 200
group = &"news_speech_2"

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_speech_step")
pause_ticks = 200
group = &"news_speech_3"

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("2_speech_step")
pause_ticks = 0
group = &"news_speech_4"

[resource]
script = ExtResource("1_story_scene")
stage = &"news_cartoon_stage"
loops = Array[StringName]([&"news_ambient"])
timelines = Array[StringName]([&"news_report"])
song = &"opening"
speech = Array[ExtResource("2_speech_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
provenance = "Dev pack: the news cartoon's scene of our own, pauses of 200 ticks between the speech groups (tools/dev_pack/dev_story.py)."
