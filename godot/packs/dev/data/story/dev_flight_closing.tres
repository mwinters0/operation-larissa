[gd_resource type="Resource" script_class="StoryScene" format=3]

[ext_resource type="Script" path="res://src/resources/story_scene.gd" id="1_story_scene"]
[ext_resource type="Script" path="res://src/resources/scene_message.gd" id="2_scene_message"]

[sub_resource type="Resource" id="Message_1"]
script = ExtResource("2_scene_message")
text = &"closing_page_0"
speech = Array[StringName]([&"jingle", &"closing_page_0"])

[sub_resource type="Resource" id="Message_2"]
script = ExtResource("2_scene_message")
text = &"closing_page_1"
speech = Array[StringName]([&"closing_page_1"])

[resource]
script = ExtResource("1_story_scene")
stage = &"dev_flight_stage"
loops = Array[StringName]([])
timelines = Array[StringName]([&"dev_flight"])
backdrop = false
messages = Array[ExtResource("2_scene_message")]([SubResource("Message_1"), SubResource("Message_2")])
provenance = "Dev pack: a closing of our own that flies the sub off and shows two pages of the surface ship's message: the flight (dev_flight, made for the place of the sub), then the pages (tools/dev_pack/dev_story.py)."
