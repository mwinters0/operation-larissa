script = ExtResource("1_cutscene_timeline")
length = 160
loop = true
tracks = Array[ExtResource("2_cutscene_track")]([SubResource("Track_1"), SubResource("Track_2"), SubResource("Track_3"), SubResource("Track_4"), SubResource("Track_5"), SubResource("Track_6"), SubResource("Track_7"), SubResource("Track_8"), SubResource("Track_9"), SubResource("Track_10"), SubResource("Track_11"), SubResource("Track_12"), SubResource("Track_13"), SubResource("Track_14"), SubResource("Track_15"), SubResource("Track_16"), SubResource("Track_17"), SubResource("Track_18"), SubResource("Track_19"), SubResource("Track_20"), SubResource("Track_21"), SubResource("Track_22"), SubResource("Track_23"), SubResource("Track_24"), SubResource("Track_25"), SubResource("Track_26"), SubResource("Track_27")])
provenance = "Dev pack: the alarm lights and the pulsing ring, a loop of 16 redraws of 10 ticks; the console's lights flicker as the original's do (a generator seeded with 73, step_story.console_flicker: ours) (tools/dev_pack/dev_story.py)."
