; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Operation Larissa"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://src/autoload/game_clock.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
GameState="*res://src/autoload/game_state.gd"
SaveStore="*res://src/autoload/save_store.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
Audio="*res://src/autoload/audio.gd"
WindowHotkeys="*res://src/autoload/window_hotkeys.gd"
Mods="*res://src/autoload/mod_host.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/foe_script_editor/plugin.cfg", "res://addons/screen_editor/plugin.cfg", "res://addons/sector_editor/plugin.cfg", "res://addons/sector_overview/plugin.cfg", "res://addons/sector_checks/plugin.cfg", "res://addons/pack_tools/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://themes/neptune_theme.tres"

