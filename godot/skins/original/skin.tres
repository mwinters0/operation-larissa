[gd_resource type="Resource" script_class="GameSkin" format=3]

[ext_resource type="Script" path="res://src/skins/game_skin.gd" id="1_skin"]
[ext_resource type="Script" path="res://src/skins/render_settings.gd" id="2_render"]

[sub_resource type="Resource" id="Resource_render"]
script = ExtResource("2_render")
texture_filter = 0
snap_transforms = true
snap_vertices = true
playfield_filter = 0

[resource]
script = ExtResource("1_skin")
id = &"original"
display_name = "Original"
render = SubResource("Resource_render")
