# A skin that draws two parts of the console and raises when it is asked for the second: the bezel is drawn, the oxygen cells fault on every frame (it asks the API for a function that is not there), so the gauge stays the original's, the loader counts the
# faults and quarantines the skin in the end, and the game goes on.
var api : Dictionary = {}

func mod_init(granted : Dictionary) -> void:
	api = granted

func skin_layer(name : String, state : Dictionary, fraction : float, events : Array) -> Array:
	if name == "hud_oxygen":
		api["no_such_function"].call("frame")
	return [["rect", state["rects"]["hud_bezel"], Color(0.1, 0.1, 0.1)]]
