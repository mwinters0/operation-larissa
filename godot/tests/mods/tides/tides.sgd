# A small problem-screen mod: it draws the screen of problem type 40 ("fish in rows") from the problem it is told: a pool, a row of fish pictures of its own pack (problems/fish.png) for each row of the problem, what the player has
# typed so far, and the prompt, through the game's font. It also opts in to draw two ORIGINAL types, 3 and 5, by number: for those it draws the pictures of the type's art bundle by their keys (the game's own pictures, under the skin in
# use), the family the type's data names and what was typed; the other original types stay the original's. Every picture is built from `state`, so a screen shown late is the screen shown early.
# It also draws a progress bar from the CLOCK of the state (which animation, how many of its ticks are over, how long it is: the bar is `tick / length` of the build-up or of the replay, drawn by what the engine says
# and never by a timer of its own) and, when the test switches `sound_on()`, asks for the sound `diagram_bar` at every 15th tick the clock passed since it was last asked (`since`), as `{"draw": ..., "sounds": [...]}`; `sound_only_on()` answers
# the sounds alone. It is silent otherwise, so the plays of a problem are the same under it as under no mod. It keeps what the clock told it (for the tests to ask).
# It also REACTS to what happened (the `events`): a banner under the picture names the last event it was told and a bar changes colour with it (green for a right verdict, red for a wrong one, gold for a success,
# grey for a time out, a damage bar per oxygen lost). That is memory of events, which a picture should not be built from; here it is what the tests look at. It keeps the count of the times it was asked and every event
# it was told (for the tests to ask).
var api : Dictionary = {}
var asked := 0
var last_step := ""
var heard : Array = []
var banner := ""
var bar := Color(0.3, 0.3, 0.3)
var damage := 0
var calls_log : Array = []
var clocks : Array = []
var calls_seen_log : Array = []
var sounding := false
var sound_only := false
var asked_sounds : Array = []

func sound_on() -> void:
	sounding = true

func sound_only_on() -> void:
	sound_only = true

func calls_seen() -> Array:
	return calls_seen_log.duplicate(true)

func clocks_seen() -> Array:
	return clocks.duplicate(true)

func sounds_asked() -> Array:
	return asked_sounds.duplicate()

func events_heard() -> Array:
	return heard.duplicate(true)

func calls_log_sizes() -> Array:
	return calls_log.duplicate()

func mod_init(granted : Dictionary) -> void:
	api = granted

func times_asked() -> int:
	return asked

func react(events : Array) -> void:
	calls_log.append(events.size())
	for event in events:
		heard.append(event)
		banner = str(event[0])
		match event[0]:
			"started":
				bar = Color(0.3, 0.3, 0.3)
			"verdict":
				bar = Color(0.1, 0.8, 0.2) if event[1] else Color(0.9, 0.1, 0.1)
				banner += (" right" if event[1] else " wrong") + " try " + str(event[2])
			"damage":
				damage += event[1]
			"success":
				bar = Color(1.0, 0.8, 0.1)
			"timeout":
				bar = Color(0.5, 0.5, 0.5)
			"step":
				banner += " " + event[1]

func reaction() -> Array:
	var out := []
	out.append(["rect", Rect2(16, 300, 200, 12), bar])
	for i in damage:
		out.append(["rect", Rect2(220 + i * 14, 300, 10, 12), Color.RED])
	out.append(["text", "Heard: " + banner, Vector2(24, 320), 14, Color.WHITE])
	return out

func clock_bar(clock : Dictionary) -> Array:
	var out := []
	if clock["animation"] == "":
		return out
	clocks.append([clock["animation"], clock["tick"], clock["length"], clock["since"]])
	var width := 200
	if clock["length"] > 0:
		width = 200 * clock["tick"] / clock["length"]
	var colour := Color.CYAN if clock["animation"] == "intro" else Color.MAGENTA
	out.append(["rect", Rect2(16, 340, width, 10), colour])
	out.append(["text", clock["animation"] + " " + str(clock["tick"]) + "/" + str(clock["length"]), Vector2(24, 354), 14, Color.WHITE])
	return out

func crossings(clock : Dictionary) -> Array:
	var out := []
	if clock["animation"] == "":
		return out
	var n : int = clock["since"] + 1
	while n <= clock["tick"]:
		if n > 0 and n % 15 == 0:
			out.append("diagram_bar")
		n += 1
	return out

func problem_frame(state : Dictionary, events : Array) -> Variant:
	asked += 1
	last_step = state["step"]
	calls_seen_log.append([state["clock"]["animation"], state["clock"]["tick"], state["step"]])
	react(events)
	var out := original_type(state) if state["type"] != 40 else own_type(state)
	out.append_array(reaction())
	out.append_array(clock_bar(state["clock"]))
	if not sounding:
		return out
	var sounds := crossings(state["clock"])
	asked_sounds.append_array(sounds)
	if sound_only:
		return {"sounds": sounds}
	return {"draw": out, "sounds": sounds}

func own_type(state : Dictionary) -> Array:
	var out := []
	out.append(["rect", Rect2(16, 16, 330, 230), Color(0.02, 0.10, 0.18)])
	var rows : int = state["fields"][0]
	var per : int = state["fields"][1]
	for row in rows:
		for column in per:
			out.append(["picture", "problems/fish.png", Vector2(28 + column * 24, 28 + row * 22)])
	# the fish glow once the player is typing
	if state["entry"] != "" and state["entry"] != "0":
		out.append(["layer", "problems/glow.gdshader", {"strength": 0.5, "tint": Color(1.0, 0.9, 0.3)}])
		out.append(["region", "problems/fish.png", Rect2(300, 200, 16, 16), Rect2(0, 0, 8, 8)])
		out.append(["layer", ""])
	out.append(["text", "Typed: " + state["entry"], Vector2(24, 260), 17, Color.WHITE, 300.0, "left"])
	out.append(["text", state["title"], Vector2(24, 280), 14, Color(0.8, 0.9, 1.0)])
	return out

func original_type(state : Dictionary) -> Array:
	var out := []
	out.append(["rect", Rect2(16, 16, 330, 230), Color(0.20, 0.10, 0.02)])
	for i in state["art"].size():
		out.append(["picture", state["art"][i], Vector2(20 + i * 40, 60)])
	out.append(["text", "Type " + str(state["type"]) + " " + state["family"], Vector2(24, 24), 17, Color.WHITE])
	out.append(["text", "Typed: " + state["entry"], Vector2(24, 260), 17, Color.WHITE, 300.0, "left"])
	return out
