{
 "id": "modern",
 "title": "Modern (example skin)",
 "version": "1.0",
 "author": "Operation Larissa",
 "description": "The example skin pack: a water shimmer behind the screen, Exo 2 on the HUD, smooth filtering, and the HUD's pictures as flat templates to draw over. Laid over the legacy pack.",
 "base": "legacy",
 "mod": {
  "requires_api": 5,
  "skin": {
   "render": {
    "texture_filter": "linear",
    "snap_transforms": false,
    "snap_vertices": false
   },
   "hud_font": {
    "file": "skin/fonts/Exo2.ttf",
    "size": 14,
    "color": "#dbf7ff"
   },
   "shaders": [
    "skin/water_shimmer.gdshader",
    "skin/sharp_walls.gdshader"
   ],
   "layers": {
    "background": {
     "shader": "skin/water_shimmer.gdshader"
    },
    "walls": {
     "shader": "skin/sharp_walls.gdshader"
    }
   },
   "pictures": {
    "ui_picture/ui_1189": "skin/ui_picture/ui_1189.png",
    "ui_picture/ui_1190": "skin/ui_picture/ui_1190.png",
    "ui_picture/ui_1191": "skin/ui_picture/ui_1191.png",
