{
 "id": "modern",
 "title": "Modern (example skin)",
 "version": "1.0",
 "author": "Operation Larissa",
 "description": "The example skin pack: a water shimmer behind the screen, Exo 2 on the HUD and in the menus (a theme of cool blues that reaches the problem screen's text, calculator keys and display), smooth filtering, and the HUD's pictures as flat templates to draw over, with templates for the problem screen's frame beside them. Laid over the legacy pack.",
 "base": "legacy",
 "mod": {
  "requires_api": 5,
  "skin": {
   "render": {
    "texture_filter": "linear",
    "snap_transforms": false,
    "snap_vertices": false
   },
   "hud_font": {
    "file": "skin/fonts/Exo2.ttf",
    "weight": 600,
    "size": 14,
    "color": "#dbf7ff"
   },
   "theme": {
    "font": {
     "file": "skin/fonts/Exo2.ttf",
     "weight": 600,
     "size": 16
    },
    "colors": {
     "text": "#dbf7ff",
     "title": "#7fe0ff",
     "button": "#bfe9f7",
     "button_hover": "#ffffff",
     "button_pressed": "#ffe27a",
     "button_disabled": "#5d7b88",
     "good": "#6dffb0",
     "bad": "#ff7a8a",
     "caret": "#7fe0ff",
     "display": "#041018"
    },
    "panel": {
     "fill": "#0d2233",
     "border": "#2f7f9f",
     "border_width": 2,
     "radius": 8
    },
    "console": {
     "fill": "#07151f",
     "border": "#5fd0f0",
     "border_width": 2,
     "radius": 10
    },
    "button": {
     "normal": {
      "fill": "#123347",
      "border": "#5fd0f0",
      "radius": 6
     },
     "hover": {
      "fill": "#1c5675",
      "border": "#dbf7ff",
      "radius": 6
     },
     "pressed": {
      "fill": "#05121a",
      "border": "#ffe27a",
      "radius": 6
     },
     "disabled": {
      "fill": "#0d2233",
      "border": "#3b5663",
      "radius": 6
     },
     "focus": {
      "border": "#ffe27a",
      "radius": 6
     }
    },
    "input": {
     "normal": {
      "fill": "#04101a",
      "border": "#5fd0f0",
      "radius": 4
     },
     "focus": {
      "fill": "#04101a",
      "border": "#ffe27a",
      "radius": 4
     }
    },
    "key": {
     "hover": {
      "fill": "#5fd0f038",
      "border": "#7fe0ff"
     },
     "pressed": {
      "fill": "#ffe27a60",
      "border": "#ffe27a"
     }
    }
   },
   "shaders": [
    "skin/water_shimmer.gdshader",
    "skin/sharp_walls.gdshader"
   ],
   "layers": {
    "background": {
     "shader": "skin/water_shimmer.gdshader"
    },
    "walls": {
     "shader": "skin/sharp_walls.gdshader"
    }
   },
   "pictures": {
    "ui_picture/ui_1189": "skin/ui_picture/ui_1189.png",
    "ui_picture/ui_1190": "skin/ui_picture/ui_1190.png",
    "ui_picture/ui_1191": "skin/ui_picture/ui_1191.png",
    "ui_picture/ui_1192": "skin/ui_picture/ui_1192.png",
    "ui_picture/ui_1193": "skin/ui_picture/ui_1193.png",
    "ui_picture/ui_1194": "skin/ui_picture/ui_1194.png",
    "ui_picture/ui_1195": "skin/ui_picture/ui_1195.png",
    "ui_picture/ui_1196": "skin/ui_picture/ui_1196.png",
    "ui_picture/ui_1197": "skin/ui_picture/ui_1197.png",
    "ui_picture/ui_1198": "skin/ui_picture/ui_1198.png",
    "ui_picture/ui_1199": "skin/ui_picture/ui_1199.png",
    "ui_picture/ui_1200": "skin/ui_picture/ui_1200.png",
    "ui_picture/ui_1201": "skin/ui_picture/ui_1201.png",
    "ui_picture/ui_1202": "skin/ui_picture/ui_1202.png",
    "ui_picture/ui_1203": "skin/ui_picture/ui_1203.png",
    "ui_picture/ui_1204": "skin/ui_picture/ui_1204.png",
    "ui_picture/ui_1205": "skin/ui_picture/ui_1205.png",
    "ui_picture/ui_1206": "skin/ui_picture/ui_1206.png",
    "ui_picture/ui_1207": "skin/ui_picture/ui_1207.png",
    "ui_picture/ui_1208": "skin/ui_picture/ui_1208.png",
    "ui_picture/ui_1210": "skin/ui_picture/ui_1210.png",
    "ui_picture/ui_1211": "skin/ui_picture/ui_1211.png",
    "ui_picture/ui_1212": "skin/ui_picture/ui_1212.png",
    "ui_picture/ui_1213": "skin/ui_picture/ui_1213.png"
   }
  }
 }
}
